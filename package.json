{
  "name": "aiteacher-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AI Teacher - Monorepo with Nx",
  "scripts": {
    "dev": "concurrently --names \"MAIN,CLOUD,FRONT,ASR,NX\" --prefix-colors \"bgBlue.bold,bgMagenta.bold,bgGreen.bold,bgYellow.bold,bgCyan.bold\" --prefix \"[{name}]\" --timestamp-format \"HH:mm:ss\" --prefix-length 10 \"pnpm --filter @aiteacher/backend-main run dev\" \"pnpm --filter @aiteacher/backend-cloud run dev\" \"pnpm --filter @aiteacher/frontend run dev\" \"pnpm --filter @aiteacher/service-asr run dev\" \"NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx graph --port=10004\"",
    "dev:nx": "NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run-many --target=dev --parallel=10",
    "dev:native": "pnpm -r --parallel --filter './apps/**' run dev",
    "dev:backend": "concurrently --names \"MAIN,CLOUD\" --prefix-colors \"bgBlue.bold,bgMagenta.bold\" --prefix \"[{name}]\" \"pnpm --filter @aiteacher/backend-main run dev\" \"pnpm --filter @aiteacher/backend-cloud run dev\"",
    "dev:frontend": "pnpm --filter @aiteacher/frontend run dev",
    "dev:excalidraw": "NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run-many --target=dev --projects=excalidraw,excalidraw-room,excalidraw-firebase --parallel=3",
    "build": "NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run-many --target=build --output-style=static",
    "start": "NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run-many --target=start --output-style=static",
    "lint": "NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run-many --target=lint --output-style=static",
    "test": "pnpm test:repo && NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run-many --target=test --projects=backend-main,backend-cloud,excalidraw-room --output-style=static",
    "test:repo": "node --test tests/repo-guard.test.mjs",
    "graph": "NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx graph --port=10004",
    "stop": "pkill -f 'nodemon|nuxt dev|python funasr'"
  },
  "devDependencies": {
    "@nx/js": "^22.4.4",
    "concurrently": "^9.2.1",
    "nx": "22.4.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "overrides": {
      "vue": "3.5.28",
      "@vue/runtime-core": "3.5.28",
      "@vue/server-renderer": "3.5.28",
      "@vue/compiler-core": "3.5.28",
      "@vue/compiler-dom": "3.5.28",
      "@vue/reactivity": "3.5.28",
      "@vue/shared": "3.5.28",
      "typescript": "5.9.3"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@scarf/scarf",
      "@vue-office/docx",
      "@vue-office/excel",
      "@vue-office/pdf",
      "@vue-office/pptx",
      "esbuild",
      "nx",
      "sharp",
      "vue-demi"
    ]
  }
}
