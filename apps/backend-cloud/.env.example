# ==========================================
# 云存储后端环境变量配置示例
# ==========================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 将所有占位符替换为实际值
# 3. 不要将 .env 文件提交到版本控制
# ==========================================

# JWT令牌密钥（用于验证用户身份）
# 建议使用 32 位以上随机字符串
JWT_SECRET=your_jwt_secret_key_here

# 服务端口
PORT=10002

# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_DATABASE=aiteacher
MYSQL_PASSWORD=your_mysql_password

# Redis 缓存配置
Redis_HOST=localhost
Redis_PORT=6379
Redis_PASSWORD=your_redis_password

# ==========================================
# 云端部署配置（生产环境使用）
# ==========================================
# 取消注释并填写实际值
# PORT=10009
# MYSQL_HOST=your_production_host
# MYSQL_PORT=3306
# MYSQL_USER=your_production_user
# MYSQL_DATABASE=your_production_database
# MYSQL_PASSWORD=your_production_password
# Redis_HOST=127.0.0.1
# Redis_PORT=6379
# Redis_PASSWORD=your_production_redis_password

# ==========================================
# 文件类型图标 URL 配置
# ==========================================
# 用于显示不同文件类型的预览图标
URL_PHOTO=https://imgur.zrllove.cn:10004/short/17/48
URL_VIDEO=https://imgur.zrllove.cn:10004/short/17/47
URL_AUDIO=https://imgur.zrllove.cn:10004/short/17/46
URL_PPT=https://imgur.zrllove.cn:10004/short/17/44
URL_PDF=https://imgur.zrllove.cn:10004/short/17/45
URL_WORD=https://imgur.zrllove.cn:10004/short/17/50
URL_ZIP=https://imgur.zrllove.cn:10004/short/17/51
URL_EXCEL=https://imgur.zrllove.cn:10004/short/17/53
URL_TXT=https://imgur.zrllove.cn:10004/short/17/52
URL_OTHER=https://imgur.zrllove.cn:10004/short/17/43

# DeepSeek API 密钥（用于 AI 功能）
# 从 https://platform.deepseek.com/ 获取
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
