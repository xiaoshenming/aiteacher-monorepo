# ==========================================
# 主后端环境变量配置示例
# ==========================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 将所有占位符替换为实际值
# 3. 不要将 .env 文件提交到版本控制
# ==========================================

# JWT令牌密钥（用于验证用户身份）
# 建议使用 32 位以上随机字符串
JWT_SECRET=your_jwt_secret_key_here

# 消息队列名称
QUEUE_NAME=notificationQueue

# ==========================================
# AI 服务 API 密钥
# ==========================================

# DeepSeek API 密钥（用于 AI 对话和内容生成）
# 从 https://platform.deepseek.com/ 获取
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# AIPPT API 密钥（用于 AI 生成 PPT）
# 从 AIPPT 平台获取
AIPPT_API_KEY=ak-your_aippt_api_key_here

# 阿里百炼 API 密钥（用于阿里云 AI 服务）
# 从阿里云控制台获取
DASHSCOPE_API_KEY=sk-your_dashscope_api_key_here

# ==========================================
# 新闻 API 配置
# ==========================================
# 从新闻 API 服务商获取
NEWS_API_SECRET=your_news_api_secret_here
NEWS_API_APPID=your_news_api_appid_here

# ==========================================
# 微信开放平台配置
# ==========================================
# 从微信开放平台获取（用于微信登录）
wxAppId=wx_your_app_id_here
wxAppSecret=your_wx_app_secret_here

# ==========================================
# 本地开发环境配置
# ==========================================

# 服务端口
PORT=10001

# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_DATABASE=aiteacher
MYSQL_PASSWORD=your_mysql_password

# Redis 缓存配置
Redis_HOST=localhost
Redis_PORT=6379
Redis_PASSWORD=your_redis_password

# RabbitMQ 消息队列配置
# 格式：amqp://username:password@host:port
RABBIT_URL=amqp://admin:admin@localhost:5672

# 云存储后端服务端口（用于内部服务调用）
CLOUD_BACKEND_PORT=10002

# ==========================================
# 云端部署配置（生产环境使用）
# ==========================================
# 取消注释并填写实际值
# PORT=10010
# MYSQL_HOST=your_production_host
# MYSQL_PORT=3306
# MYSQL_USER=your_production_user
# MYSQL_DATABASE=your_production_database
# MYSQL_PASSWORD=your_production_password
# Redis_HOST=127.0.0.1
# Redis_PORT=6379
# Redis_PASSWORD=your_production_redis_password
# RABBIT_URL=amqp://guest:guest@127.0.0.1:5672
# CLOUD_BACKEND_PORT=10009
