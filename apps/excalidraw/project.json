{
  "name": "excalidraw",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/excalidraw",
  "targets": {
    "dev": {
      "command": "pnpm start",
      "options": {
        "cwd": "apps/excalidraw"
      }
    },
    "build": {
      "command": "pnpm build",
      "options": {
        "cwd": "apps/excalidraw"
      }
    },
    "install": {
      "command": "pnpm install",
      "options": {
        "cwd": "apps/excalidraw"
      }
    }
  }
}
