FROM node:20-alpine

# 安装 ffmpeg（音视频处理依赖）
RUN apk add --no-cache ffmpeg

WORKDIR /app

# 复制应用源码
COPY apps/backend-cloud/ ./

# 删除源码自带的 .env（使用 Compose 注入的环境变量）
RUN rm -f .env .env.local .env.example

# 安装生产依赖
RUN npm install --omit=dev

# 创建 storage 子目录
RUN mkdir -p storage/audio storage/chunks storage/editor storage/files storage/mobile_files

ENV NODE_ENV=production

EXPOSE 10002

CMD ["node", "app.js"]
