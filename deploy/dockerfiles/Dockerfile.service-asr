FROM python:3.11-slim

# 安装系统依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends libsndfile1 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 只用预编译 wheel，不编译源码（--only-binary :all: 对有些包不行，分步装）
# 1. 先装 PyTorch CPU 版（从官方源，预编译 wheel）
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cpu

# 2. 装 funasr 的全部依赖（预编译 wheel + funasr requires 列表）
RUN pip install --no-cache-dir modelscope soundfile numpy pyyaml editdistance typeguard onnxruntime rotary-embedding-torch \
    hydra-core omegaconf torch-complex jaconv jamo jieba kaldiio librosa scipy sentencepiece hdbscan umap-learn

# 3. 装 funasr 本身（--no-deps 跳过 umap 依赖问题）
RUN pip install --no-cache-dir --no-deps funasr==1.0.0

# 4. 复制 requirements.txt 装剩余依赖
COPY apps/service-asr/requirements.txt ./
RUN grep -v "^funasr" requirements.txt | grep -v "^#" | grep -v "^$" | \
    pip install --no-cache-dir -r /dev/stdin 2>/dev/null || true

# 复制应用源码
COPY apps/service-asr/ ./

# models 目录通过 volume 挂载
RUN mkdir -p models

EXPOSE 10005

CMD ["python", "funasr_service.py"]
