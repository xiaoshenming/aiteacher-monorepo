FROM node:20

# 安装 Java (Firebase 模拟器依赖)
RUN apt-get update && apt-get install -y --no-install-recommends default-jre-headless && rm -rf /var/lib/apt/lists/*

# 安装 firebase-tools
RUN npm install -g firebase-tools

WORKDIR /app

# 复制 Firebase 配置文件
COPY apps/excalidraw-firebase/firebase.json ./
COPY apps/excalidraw-firebase/.firebaserc* ./
COPY apps/excalidraw-firebase/firestore.rules ./
COPY apps/excalidraw-firebase/storage.rules ./

# 创建持久化数据目录
RUN mkdir -p data

EXPOSE 10009 10010 10011

CMD ["firebase", "emulators:start", "--import=./data", "--export-on-exit=./data"]
