# Excalidraw 白板前端 - 使用预构建产物
FROM nginx:alpine

# 复制本地预构建的静态文件
COPY excalidraw-build/ /usr/share/nginx/html

# SPA fallback nginx 配置
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
