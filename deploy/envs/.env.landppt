# =============================================================================
# AI Generation Parameters
# =============================================================================
MAX_TOKENS=128000
TEMPERATURE=0.7
TOP_P=1.0

# =============================================================================
# Application Configuration (生产环境)
# =============================================================================
HOST=0.0.0.0
PORT=10006
DEBUG=false
RELOAD=false

SECRET_KEY=your-very-secure-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=300

MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
CACHE_TTL=3600
DATABASE_URL=sqlite:///./landppt.db

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_NETWORK_MODE=true
ENABLE_LOCAL_MODELS=false
ENABLE_STREAMING=true

# =============================================================================
# Image Service
# =============================================================================
ENABLE_IMAGE_SERVICE=true
ENABLE_LOCAL_IMAGES=false
ENABLE_NETWORK_SEARCH=false
ENABLE_AI_GENERATION=true
LOCAL_IMAGES_SMART_SELECTION=true
ENABLE_SMART_IMAGE_SELECTION=true

MAX_LOCAL_IMAGES_PER_SLIDE=2
MAX_NETWORK_IMAGES_PER_SLIDE=1
MAX_AI_IMAGES_PER_SLIDE=2
MAX_TOTAL_IMAGES_PER_SLIDE=1

DEFAULT_AI_IMAGE_PROVIDER=dashscope
DEFAULT_NETWORK_SEARCH_PROVIDER=pixabay

AI_IMAGE_QUALITY=standard

# Gemini Image
GEMINI_IMAGE_API_KEY=your_google_api_key_here
GEMINI_IMAGE_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_IMAGE_MODEL=

# OpenAI Image
OPENAI_IMAGE_MODEL=qwen-vl-max-latest
OPENAI_IMAGE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
OPENAI_IMAGE_QUALITY=auto
OPENAI_IMAGE_API_KEY=sk-7c0d7996ace54d368aa8a6f05b0078e0

# DashScope Image
DASHSCOPE_API_KEY=sk-7c0d7996ace54d368aa8a6f05b0078e0
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_MODEL=wan2.2-t2i-flash
DASHSCOPE_IMAGE_SIZE=1440*810

# =============================================================================
# Logging (生产环境)
# =============================================================================
LOG_LEVEL=INFO
LOG_AI_REQUESTS=false

AI_IMAGE_RESOLUTION_PRESETS={"dalle":["1792x1024","1024x1792","1024x1024"],"openai_image":["1536x1024","1024x1536","1024x1024"],"siliconflow":["1024x1024","1344x768","768x1344"],"gemini":["1024x1024","1344x768","768x1344"],"pollinations":["1024x1024","1280x720","720x1280"]}
