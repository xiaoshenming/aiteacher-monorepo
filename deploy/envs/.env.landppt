POLLINATIONS_SAFE=false
POLLINATIONS_NOLOGO=false
POLLINATIONS_PRIVATE=false
POLLINATIONS_TRANSPARENT=false
ENABLE_PARALLEL_GENERATION=true
ENABLE_AUTO_LAYOUT_REPAIR=false
PARALLEL_SLIDES_COUNT=5
MINERU_BASE_URL=https://mineru.net/api/v4
BASE_URL=http://localhost:10006
